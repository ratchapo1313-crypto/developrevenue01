{
  "entities": {
    "TaxpayerRecord": {
      "title": "TaxpayerRecord",
      "description": "Taxpayer information for land and sign taxes including old debt tracking",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "taxType": { "type": "string", "enum": ["land", "sign"] },
        "assessedAmount": { "type": "number" },
        "reliefAmount": { "type": "number" },
        "afterReliefAmount": { "type": "number" },
        "status": { "type": "number" },
        "payment1": { "type": "number" },
        "payment2": { "type": "number" },
        "payment3": { "type": "number" },
        "remainingBalance": { "type": "number" },
        "isFullyPaid": { "type": "boolean" },
        "isPendingVerification": { "type": "boolean" },
        "hasOldDebt": { "type": "boolean" },
        "oldDebtAmount": { "type": "number" },
        "oldDebtStatus": { "type": "number" },
        "oldDebtPaid": { "type": "number" },
        "oldDebtRemaining": { "type": "number" },
        "penaltyAmount": { "type": "number" },
        "surchargeAmount": { "type": "number" },
        "notes": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "name", "taxType"]
    },
    "OldTaxDebtorRecord": {
      "title": "OldTaxDebtorRecord",
      "description": "Outstanding tax debtors record from prior fiscal years",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "taxType": { "type": "string", "enum": ["land", "sign"] },
        "taxYear": { "type": "string" },
        "debtAmount": { "type": "number" },
        "paidAmount": { "type": "number" },
        "remainingAmount": { "type": "number" },
        "status": { "type": "number" },
        "installmentCount": { "type": "number" },
        "notes": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "name", "taxType", "debtAmount"]
    },
    "DailyRecord": {
      "title": "DailyRecord",
      "description": "Daily revenue cash receipt entry",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "date": { "type": "string" },
        "categoryId": { "type": "string" },
        "categoryName": { "type": "string" },
        "itemId": { "type": "string" },
        "itemName": { "type": "string" },
        "amount": { "type": "number" },
        "receiptBookNo": { "type": "string" },
        "receiptNo": { "type": "string" },
        "payerName": { "type": "string" },
        "note": { "type": "string" },
        "recordedAt": { "type": "string" }
      },
      "required": ["id", "date", "categoryId", "itemId", "amount"]
    },
    "RevenueCategory": {
      "title": "RevenueCategory",
      "description": "Budget revenue category definition and item lines for 8 municipal revenue categories",
      "type": "object",
      "properties": {
        "key": { "type": "string" },
        "title": { "type": "string" },
        "shortTitle": { "type": "string" },
        "description": { "type": "string" },
        "totalEstimate": { "type": "number" },
        "totalActual": { "type": "number" },
        "percentage": { "type": "number" },
        "itemCount": { "type": "number" },
        "items": { "type": "array" },
        "updatedAt": { "type": "string" },
        "lastUpdatedBy": { "type": "string" }
      },
      "required": ["key", "title"]
    },
    "TaxSummary": {
      "title": "TaxSummary",
      "description": "Aggregated summary of land tax or sign tax",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "taxType": { "type": "string" },
        "estimateCount": { "type": "number" },
        "estimateAmount": { "type": "number" },
        "collected": { "type": "object" },
        "taxpayers": { "type": "object" },
        "debtors": { "type": "object" },
        "pendingVerification": { "type": "object" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "taxType"]
    },
    "OfficialMemorandumRecord": {
      "title": "OfficialMemorandumRecord",
      "description": "Official memorandum report data for the Revenue Development Division",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "docNo": { "type": "string" },
        "docDate": { "type": "string" },
        "subject": { "type": "string" },
        "department": { "type": "string" },
        "fiscalYear": { "type": "string" },
        "reporterName": { "type": "string" },
        "reporterPosition": { "type": "string" },
        "directorName": { "type": "string" },
        "directorPosition": { "type": "string" },
        "executiveName": { "type": "string" },
        "executivePosition": { "type": "string" },
        "summary": { "type": "object" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "docNo", "docDate", "subject"]
    },
    "MarketSummaryRecord": {
      "title": "MarketSummaryRecord",
      "description": "Summary data for municipal municipal fresh and night markets",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "marketType": { "type": "string", "enum": ["fresh_market", "night_market"] },
        "name": { "type": "string" },
        "totalStalls": { "type": "number" },
        "occupiedStalls": { "type": "number" },
        "dailyRate": { "type": "number" },
        "monthlyEstimate": { "type": "number" },
        "monthlyActual": { "type": "number" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "marketType", "name"]
    },
    "MarketContractRecord": {
      "title": "MarketContractRecord",
      "description": "Individual market vendor stall lease contract",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "marketType": { "type": "string" },
        "stallNo": { "type": "string" },
        "vendorName": { "type": "string" },
        "monthlyFee": { "type": "number" },
        "contractStartDate": { "type": "string" },
        "contractEndDate": { "type": "string" },
        "status": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "marketType", "stallNo", "vendorName"]
    },
    "OverviewMetricsRecord": {
      "title": "OverviewMetricsRecord",
      "description": "Calculated overview KPI metrics for executive municipal dashboard",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "fiscalYear": { "type": "string" },
        "totalEstimate": { "type": "number" },
        "totalActual": { "type": "number" },
        "percentage": { "type": "number" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "fiscalYear", "totalEstimate", "totalActual"]
    },
    "AppDatabaseDoc": {
      "title": "AppDatabaseDoc",
      "description": "Central state document for live cross-device synchronization and backup",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "categories": { "type": "array" },
        "landTax": { "type": "object" },
        "signTax": { "type": "object" },
        "taxpayers": { "type": "array" },
        "dailyRecords": { "type": "array" },
        "marketContracts": { "type": "array" },
        "marketSummaries": { "type": "object" },
        "version": { "type": "number" },
        "updatedAt": { "type": "string" },
        "lastUpdatedBy": { "type": "string" }
      },
      "required": ["id", "version", "updatedAt"]
    }
  },
  "firestore": {
    "/taxpayers/{taxpayerId}": {
      "schema": "TaxpayerRecord",
      "description": "Collection of taxpayer records for land and sign tax"
    },
    "/old_tax_debtors/{debtorId}": {
      "schema": "OldTaxDebtorRecord",
      "description": "Collection of outstanding prior-year tax debtors"
    },
    "/daily_records/{recordId}": {
      "schema": "DailyRecord",
      "description": "Collection of daily collection receipts"
    },
    "/revenue_categories/{categoryKey}": {
      "schema": "RevenueCategory",
      "description": "Collection of 8 revenue categories and items"
    },
    "/tax_summaries/{taxType}": {
      "schema": "TaxSummary",
      "description": "Summary data for land tax and sign tax"
    },
    "/official_memorandums/{memoId}": {
      "schema": "OfficialMemorandumRecord",
      "description": "Collection of official municipal memorandums and reports"
    },
    "/market_summaries/{marketType}": {
      "schema": "MarketSummaryRecord",
      "description": "Collection of municipal market summaries (Fresh & Night Market)"
    },
    "/market_contracts/{contractId}": {
      "schema": "MarketContractRecord",
      "description": "Collection of municipal market stall lease contracts"
    },
    "/overview_metrics/{docId}": {
      "schema": "OverviewMetricsRecord",
      "description": "Collection of aggregated municipal overview KPI metrics"
    },
    "/app_state/{docId}": {
      "schema": "AppDatabaseDoc",
      "description": "Central state documents for live cross-device sync"
    }
  }
}
