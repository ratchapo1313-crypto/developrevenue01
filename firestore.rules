rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        (request.auth.token.email == 'collectsarakham@gmail.com' && request.auth.token.email_verified == true) ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // 1. Central App state synchronization (central DB sync & auto-bootstrap)
    match /app_state/{docId} {
      allow read: if true;
      allow create, update: if isValidId(docId) && (
        incoming().updatedAt is string &&
        incoming().updatedAt.size() <= 64
      );
      allow delete: if true;
    }

    // 2. Taxpayers collection (land and sign tax records - CRUD)
    match /taxpayers/{taxpayerId} {
      allow read: if true;
      allow create, update: if isValidId(taxpayerId) && (
        incoming().name is string && incoming().name.size() > 0 && incoming().name.size() <= 500 &&
        incoming().taxType in ['land', 'sign']
      );
      allow delete: if true;
    }

    // 3. Old tax debtors collection (prior fiscal year debts - CRUD)
    match /old_tax_debtors/{debtorId} {
      allow read: if true;
      allow create, update: if isValidId(debtorId) && (
        incoming().name is string && incoming().name.size() > 0 &&
        incoming().taxType in ['land', 'sign']
      );
      allow delete: if true;
    }

    // 4. Daily revenue collection receipts (CRUD)
    match /daily_records/{recordId} {
      allow read: if true;
      allow create, update: if isValidId(recordId) && (
        incoming().date is string && incoming().date.size() <= 32 &&
        incoming().amount is number
      );
      allow delete: if true;
    }

    // 5. 8 Revenue Categories and budget items (CRUD)
    match /revenue_categories/{categoryKey} {
      allow read: if true;
      allow create, update: if isValidId(categoryKey) && (
        incoming().key is string &&
        incoming().title is string && incoming().title.size() <= 200
      );
      allow delete: if true;
    }

    // 6. Tax summaries (land and sign tracking metrics - CRUD)
    match /tax_summaries/{taxType} {
      allow read: if true;
      allow create, update: if isValidId(taxType) && taxType in ['land', 'sign'];
      allow delete: if true;
    }

    // 7. Official memorandums (government memo reports - CRUD)
    match /official_memorandums/{memoId} {
      allow read: if true;
      allow create, update: if isValidId(memoId) && (
        incoming().docNo is string &&
        incoming().docDate is string
      );
      allow delete: if true;
    }

    // 8. Municipal Market summaries (fresh and night market - CRUD)
    match /market_summaries/{marketType} {
      allow read: if true;
      allow create, update: if isValidId(marketType) && (
        incoming().name is string
      );
      allow delete: if true;
    }

    // 9. Municipal Market stall lease contracts (CRUD)
    match /market_contracts/{contractId} {
      allow read: if true;
      allow create, update: if isValidId(contractId) && (
        incoming().vendorName is string
      );
      allow delete: if true;
    }

    // 10. Executive Overview KPI metrics (CRUD)
    match /overview_metrics/{docId} {
      allow read: if true;
      allow create, update: if isValidId(docId) && (
        incoming().totalEstimate is number &&
        incoming().totalActual is number
      );
      allow delete: if true;
    }

    // 11. Admins collection
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
  }
}
